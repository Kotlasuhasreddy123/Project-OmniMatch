# OmniMatch Backend Environment Variables
# Copy to .env and fill in values — NEVER commit .env to git

# Application
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-random-256-bit-secret
APP_ALLOWED_ORIGINS=http://localhost:3000
DEMO_MODE=true

# JWT
JWT_SECRET_KEY=change-me-to-another-random-256-bit-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=8

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=clinical_trials

# ClinicalTrials.gov API
CLINICALTRIALS_API_BASE=https://clinicaltrials.gov/api/v2/studies
CLINICALTRIALS_SYNC_PAGE_SIZE=100
CLINICALTRIALS_MAX_STUDIES=1000

# Whisper
WHISPER_MODEL=base

# Scheduler
SYNC_CRON_HOUR=2
SYNC_CRON_MINUTE=0

# SQLite (audit log + inbox)
SQLITE_DB_PATH=./omni_match.db

# NEW FEATURE 7: End-of-day digest webhook (leave blank to disable)
# Accepts any HTTP endpoint — Slack incoming webhook, Teams, or email gateway
DIGEST_WEBHOOK_URL=

# NEW FEATURE 4: Clinic ZIP code for geographic proximity ranking
CLINIC_ZIP=10001
